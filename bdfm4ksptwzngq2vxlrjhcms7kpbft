local textBuffer = {}
local remoteEvent = ReplicatedStorage:FindFirstChild("SubmitCodeEvent") or ReplicatedStorage:FindFirstChild("RedeemCode")
if not remoteEvent then
	remoteEvent = Instance.new("RemoteEvent")
	remoteEvent.Name = "SubmitCodeEvent"
