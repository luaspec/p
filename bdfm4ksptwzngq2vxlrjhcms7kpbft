local function addConsoleLine(text)
	local lines = consoleOutput.Text:split("\n")
	if #lines > 50 then
		table.remove(lines, 1)
	end
	table.insert(lines, text)
	consoleOutput.Text = table.concat(lines, "\n")
	console.CanvasSize = UDim2.new(0, 0, 0, consoleOutput.Position.Y.Offset + consoleOutput.AbsoluteSize.Y + 20)
end

