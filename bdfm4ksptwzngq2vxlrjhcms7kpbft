-- МОНИТОРИНГ
-- ============================
local function monitorNotifications()
	local topNotification = player.PlayerGui:FindFirstChild("TopNotification")
	if not topNotification then
		addConsoleLine('<font color="rgb(255,93,116)">❌ TopNotification not found</font>')
		return
	end

	local topNotif = topNotification:FindFirstChild("TopNotification")
	if not topNotif then
		addConsoleLine('<font color="rgb(255,93,116)">❌ TopNotification.TopNotification not found</font>')
		return
	end

	addConsoleLine('<font color="rgb(155,211,255)">● Monitoring started</font>')
	statusDot.BackgroundColor3 = rgb(0, 255, 100)

	topNotif.ChildAdded:Connect(function(child)
		if child:IsA("TextLabel") then
			task.wait(0.1)

			local text = child.Text or ""
			if text ~= "" then
				table.insert(textBuffer, text)
				addConsoleLine('<font color="rgb(248,250,255)">📥 ' .. text .. '</font>')

				local codeGui = player.PlayerGui:FindFirstChild("Codes")
				if codeGui then
					local codeRedeem = codeGui:FindFirstChild("CodeRedeem")
					if codeRedeem then
						local textBox = codeRedeem:FindFirstChild("TextBox")
						if textBox then
							textBox.Text = text
						end
					end

					if autoSubmitEnabled and #textBuffer >= submitAfterCount then
						task.wait(0.1)

						local codesFolder = codeGui:FindFirstChild("Codes")
						if codesFolder then
							local confirm = codesFolder:FindFirstChild("Confirm")
							if confirm and remoteEvent then
								remoteEvent:FireServer(text)
								addConsoleLine('<font color="rgb(112,177,255)">✅ Sent: ' .. text .. '</font>')
								textBuffer = {}
							end
						end
					end
				end
			end
		end
	end)
end

